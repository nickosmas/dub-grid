install-strategy=nested

# Dependency lifecycle scripts never run on install.
#
# A compromised package's `preinstall`/`postinstall` executes during `npm ci`,
# before any of our code imports it, with full access to `process.env`, the
# keychain, and every credential on the machine or CI runner. That is the entry
# point the August 2026 npm worm used across hundreds of packages, and it is the
# one class of supply-chain risk we can switch off outright.
#
# The few dependencies that genuinely need a native build or binary download are
# rebuilt explicitly, by name, via `npm run deps:rebuild`. Widen that allowlist
# deliberately; never relax this flag.
ignore-scripts=true
