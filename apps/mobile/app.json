{
  "expo": {
    "name": "DubGrid",
    "slug": "dubgrid-mobile",
    "scheme": "dubgridmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dubgrid.mobile"
    },
    "android": {
      "package": "com.dubgrid.mobile"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
