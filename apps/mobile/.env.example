# DubGrid mobile Expo environment
#
# `npm run use:mobile:local` generates apps/mobile/.env.local from the repo's
# current local web/Supabase config and rewrites localhost URLs to your laptop's
# private LAN IP so Expo Go on a phone can reach them.
#
# You can still copy this file manually if you want to override the generated
# values or point the app at a tunnel.
#
# Important:
# - 127.0.0.1 and localhost only work on the same device that runs the app.
# - For a real phone, use a public host, a tunnel URL, or a reachable LAN IP.

EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
