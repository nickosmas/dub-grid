# DubGrid mobile Expo environment
#
# `npm run use:mobile:local` generates apps/mobile/.env.local from the repo's
# current local web/Supabase config and rewrites localhost URLs to your laptop's
# private LAN IP so Expo Go on a phone can reach them.
#
# You can still copy this file manually if you want to override the generated
# values or point the app at a tunnel.
#
# Important:
# - 127.0.0.1 and localhost only work on the same device that runs the app.
# - For a real phone, use a public host, a tunnel URL, or a reachable LAN IP.
# - Never point EXPO_PUBLIC_API_BASE_URL at a host that redirects. iOS drops
#   the Authorization header across a cross-host redirect, so sign-in
#   succeeds and the first authenticated call then 401s, which the app
#   treats as an expired session and returns to the login screen.
#
# `npm run use:mobile:remote` copies apps/mobile/.env.remote over .env.local
# to reach the hosted backend. That file is untracked, so create it with:
#
#   EXPO_PUBLIC_SUPABASE_URL=<hosted project URL>
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<hosted publishable key>
#   EXPO_PUBLIC_API_BASE_URL=https://www.dubgrid.com
#
# www, not the bare apex: https://dubgrid.com 307s to www.

EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Development-only, sanitized authentication-entry measurements. Leave off
# during ordinary development and never enable in a production build.
EXPO_PUBLIC_AUTH_ENTRY_MEASUREMENT=0
