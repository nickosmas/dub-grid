{
  "name": "@dubgrid/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  },
  "scripts": {
    "prepare-shared-packages": "npm --prefix ../.. run build:packages",
    "ensure-local-env": "node ../../scripts/ensure-mobile-local-env.mjs",
    "predev": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prelan": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prephone": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prestart": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preandroid": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preios": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preweb": "npm run prepare-shared-packages",
    "dev": "expo start --lan",
    "lan": "expo start --lan",
    "phone": "expo start --tunnel",
    "start": "expo start",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/generate-app-icons.mjs",
    "test": "vitest run --config vitest.config.mts src",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "babel-preset-expo": "~57.0.16"
  },
  "dependencies": {
    "@dubgrid/api-client": "*",
    "@dubgrid/client-errors": "*",
    "@dubgrid/contracts": "*",
    "@dubgrid/design-tokens": "*",
    "@dubgrid/domain": "*",
    "@dubgrid/realtime-core": "*",
    "@dubgrid/schedule-core": "*",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.104.1",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "5.101.4",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  }
}
