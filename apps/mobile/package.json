{
  "name": "@dubgrid/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare-shared-packages": "npm --prefix ../.. run build:packages",
    "ensure-local-env": "node ../../scripts/ensure-mobile-local-env.mjs",
    "predev": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prelan": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prephone": "npm run prepare-shared-packages && npm run ensure-local-env",
    "prestart": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preandroid": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preios": "npm run prepare-shared-packages && npm run ensure-local-env",
    "preweb": "npm run prepare-shared-packages",
    "dev": "expo start --lan",
    "lan": "expo start --lan",
    "phone": "expo start --tunnel",
    "start": "expo start",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts src",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "babel-preset-expo": "~54.0.10"
  },
  "dependencies": {
    "@dubgrid/api-client": "*",
    "@dubgrid/client-errors": "*",
    "@dubgrid/contracts": "*",
    "@dubgrid/design-tokens": "*",
    "@dubgrid/domain": "*",
    "@dubgrid/realtime-core": "*",
    "@dubgrid/schedule-core": "*",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-tracking-transparency": "~6.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  }
}
