# ============================================================================
# DubGrid Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Required vars are marked [REQUIRED]. Everything else is optional and can be
# enabled as needed. The app validates env vars on startup via src/lib/env.ts.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — Client (exposed to browser)
# ----------------------------------------------------------------------------
# [REQUIRED] Your Supabase project URL and anon key.
# Find these at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ----------------------------------------------------------------------------
# Supabase — Server only
# ----------------------------------------------------------------------------
# [REQUIRED] Service role key for server-side admin operations (bypasses RLS).
# Never expose this to the client.
SUPABASE_SECRET_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Site URL
# ----------------------------------------------------------------------------
# Public-facing URL used for email links (invitations, password resets, etc.).
# Falls back to NEXT_PUBLIC_VERCEL_URL in preview deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Vercel Cron
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Shared secret for the scheduled jobs declared in
# apps/web/vercel.json: expire-requests (hourly), trial-expiry, sandbox-cleanup,
# reconcile-org-domains. Vercel injects `Authorization: Bearer $CRON_SECRET`
# into cron invocations only when this variable exists on the project. Leave it
# unset and every run returns 503, which Vercel reports as a failed cron job.
# Not needed locally — the crons only run on Vercel. Generate with:
#   openssl rand -hex 32
# CRON_SECRET=your-random-cron-secret

# ----------------------------------------------------------------------------
# Google Maps Places (client-side address autocomplete)
# ----------------------------------------------------------------------------
# Optional browser-restricted key for organization address autocomplete.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# ----------------------------------------------------------------------------
# Subdomain Routing
# ----------------------------------------------------------------------------
# Base domain for org subdomain parsing (e.g., app.dubgrid.com).
# Leave empty for local dev without subdomain support.
# NEXT_PUBLIC_BASE_DOMAIN=app.dubgrid.com

# ----------------------------------------------------------------------------
# Email (Resend) — https://resend.com
# ----------------------------------------------------------------------------
# Required for invitation emails, demo requests, and impersonation notifications.
# RESEND_API_KEY=re_your-resend-key
# Optional: Expo push access token for native mobile notifications
# EXPO_ACCESS_TOKEN=your-expo-access-token
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# DEMO_RECIPIENT_EMAIL=team@yourdomain.com

# ----------------------------------------------------------------------------
# Upstash Redis — Rate limiting & caching — https://console.upstash.com
# ----------------------------------------------------------------------------
# Required for rate limiting on auth endpoints and API route caching.
# Without these, rate limiting is disabled (logs a warning in dev).
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ----------------------------------------------------------------------------
# Stripe — Billing & subscriptions — https://dashboard.stripe.com
# ----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price-id

# ----------------------------------------------------------------------------
# Sentry — Error tracking — https://sentry.io
# ----------------------------------------------------------------------------
# Server-side DSN (used in sentry.server.config.ts and sentry.edge.config.ts)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# Client-side DSN (used in sentry.client.config.ts)
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ----------------------------------------------------------------------------
# PostHog — Analytics & feature flags — https://posthog.com
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Database (scripts only)
# ----------------------------------------------------------------------------
# Used by seed.ts and scripts/reset-remote-db.ts. Not needed for the app itself.
# If DATABASE_URL is set, it takes priority over SUPABASE_DB_PASSWORD.
# DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
# SUPABASE_DB_PASSWORD=your-db-password
