{
  "name": "@dubgrid/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-env": "node ../../scripts/sync-web-env.mjs",
    "prepare-shared-packages": "npm --prefix ../.. run build:packages",
    "predev": "npm run prepare-shared-packages && npm run prepare-env && node -e \"const fs=require('fs'),p=require('path'),d=p.join('.next','dev');fs.mkdirSync(d,{recursive:true});const m=p.join(d,'prerender-manifest.json');if(!fs.existsSync(m))fs.writeFileSync(m,JSON.stringify({version:4,routes:{},dynamicRoutes:{},notFoundRoutes:[],preview:{previewModeId:'',previewModeSigningKey:'',previewModeEncryptionKey:''}}))\"",
    "predev:webpack": "npm run prepare-shared-packages && npm run prepare-env",
    "prebuild": "npm run prepare-shared-packages && npm run prepare-env",
    "prestart": "npm run prepare-env",
    "preanalyze": "npm run prepare-env",
    "dev": "npm run predev && NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev --turbopack",
    "dev:lan": "npm run predev && NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev --hostname 0.0.0.0 --turbopack",
    "dev:webpack": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev --webpack",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts src",
    "start": "next start",
    "analyze": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 ANALYZE=true next build",
    "email:dev": "email dev --dir src/emails",
    "email:build": "vitest run --config vitest.config.mts scripts/generate-auth-email-templates.test.mts",
    "email:lockup": "npx tsx scripts/generate-wordmark-lockup.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dubgrid/authz": "*",
    "@dubgrid/client-errors": "*",
    "@dubgrid/contracts": "*",
    "@dubgrid/data-access": "*",
    "@dubgrid/db-types": "*",
    "@dubgrid/design-tokens": "*",
    "@dubgrid/domain": "*",
    "@dubgrid/mobile-api-core": "*",
    "@dubgrid/realtime-core": "*",
    "@dubgrid/schedule-core": "*",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^0.577.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "posthog-js": "^1.416.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.1",
    "sonner": "^2.0.8",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tz-lookup": "^6.1.25",
    "uuid": "^14.0.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@next/env": "^16.3.1",
    "@react-email/ui": "^6.9.2",
    "react-email": "^6.9.2"
  }
}
