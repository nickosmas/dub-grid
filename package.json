{
  "name": "dub-grid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@dubgrid/web",
    "dev:web": "turbo run dev --filter=@dubgrid/web",
    "dev:web:lan": "npm --workspace @dubgrid/web run dev:lan",
    "dev:mobile": "npm --workspace @dubgrid/mobile run dev --",
    "dev:mobile:phone": "npm --workspace @dubgrid/mobile run phone",
    "dev:mobile:lan": "npm --workspace @dubgrid/mobile run lan",
    "dev:webpack": "turbo run dev:webpack --filter=@dubgrid/web",
    "build": "turbo run build --filter=@dubgrid/web",
    "start": "npm --workspace @dubgrid/web run start",
    "lint": "eslint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@dubgrid/web",
    "test:mobile": "turbo run test --filter=@dubgrid/mobile --filter=@dubgrid/contracts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "npx tsx --env-file=.env.local seed.ts",
    "db:reset": "supabase db reset && FORCE_LOCAL_DB=1 npm run seed",
    "db:reset:remote": "npx tsx --env-file=.env.remote scripts/reset-remote-db.ts && npx tsx --env-file=.env.remote seed.ts",
    "test:load": "k6 run load-tests/schedule-load.js",
    "test:load:auth": "k6 run load-tests/auth-flow.js",
    "test:load:stress": "SCENARIO=stress k6 run load-tests/schedule-load.js",
    "analyze": "turbo run analyze --filter=@dubgrid/web",
    "use:local": "ln -sf .env.local.bak .env.local && echo 'Switched to local Supabase'",
    "use:mobile:local": "node scripts/use-mobile-local.mjs",
    "use:mobile:remote": "cp apps/mobile/.env.remote apps/mobile/.env.local && echo 'Switched mobile app to the remote backend in apps/mobile/.env.local'",
    "use:remote": "ln -sf .env.remote .env.local && echo 'Switched to remote Supabase'",
    "gen:types": "npx supabase gen types --lang=typescript --local > apps/web/src/lib/database.types.ts"
  },
  "overrides": {
    "axios": "1.14.0",
    "react-native": "0.81.5",
    "tar": "^7.5.13",
    "tmp": ">=0.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.97.20",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.36",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cli-spinners": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "fast-check": "^4.5.3",
    "jsdom": "^27.0.1",
    "kleur": "^4.1.5",
    "pg": "^8.20.0",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "turbo": "^2.5.6",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "zod": "3.24.4"
  }
}
