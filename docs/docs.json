{
  "$schema": "https://mintlify.com/docs.json",
  "name": "DubGrid",
  "theme": "almond",
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#2663EB"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/nickosmas/dub-grid"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "onboarding"]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/schedule-grid",
              "features/draft-publish",
              "features/recurring-shifts",
              "features/real-time-collaboration",
              "features/shift-requests",
              "features/dashboard"
            ]
          },
          {
            "group": "Staff Management",
            "pages": ["staff/roster", "staff/detail-page", "staff/invitations"]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/organization",
              "configuration/shifts-jobs-and-absences",
              "configuration/schedule-rules-and-display",
              "configuration/departments-and-focus-areas",
              "configuration/roles-certifications-and-indicators",
              "configuration/coverage-requirements",
              "configuration/terminology",
              "configuration/organization-activity-and-controls"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Roles & Permissions",
            "pages": ["reference/roles", "reference/admin-permissions"]
          },
          {
            "group": "Billing",
            "pages": ["reference/billing", "reference/subscription"]
          },
          {
            "group": "API",
            "pages": ["reference/api-overview", "reference/calendar-export"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/configuration/focus-areas",
      "destination": "/configuration/departments-and-focus-areas",
      "permanent": true
    },
    {
      "source": "/configuration/shift-codes",
      "destination": "/configuration/shifts-jobs-and-absences",
      "permanent": true
    }
  ]
}
