{
  "$schema": "https://mintlify.com/docs.json",
  "name": "DubGrid",
  "theme": "almond",
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#2663EB"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "onboarding"]
          },
          {
            "group": "Schedule and staffing",
            "pages": [
              "features/schedule-grid",
              "features/schedule-tools",
              "features/coverage-and-open-shifts",
              "features/draft-publish",
              "features/recurring-shifts",
              "features/real-time-collaboration",
              "features/shift-requests"
            ]
          },
          {
            "group": "Stay informed",
            "pages": [
              "features/dashboard",
              "features/alerts",
              "features/reports",
              "features/mobile-navigation",
              "features/mobile-schedule"
            ]
          },
          {
            "group": "Staff Management",
            "pages": ["staff/roster", "staff/detail-page", "staff/invitations"]
          },
          {
            "group": "Your Account",
            "pages": [
              "account/profile",
              "account/security-and-sessions",
              "account/notification-privacy-and-data-controls"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/organization",
              "configuration/shifts-jobs-and-absences",
              "configuration/schedule-rules-and-display",
              "configuration/departments-and-focus-areas",
              "configuration/roles-certifications-and-indicators",
              "configuration/coverage-requirements",
              "configuration/terminology",
              "configuration/organization-activity-and-controls"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Roles & Permissions",
            "pages": ["reference/roles", "reference/admin-permissions"]
          },
          {
            "group": "Billing",
            "pages": ["reference/billing"]
          },
          {
            "group": "Integrations",
            "pages": ["reference/integrations-and-exports"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/configuration/focus-areas",
      "destination": "/configuration/departments-and-focus-areas",
      "permanent": true
    },
    {
      "source": "/configuration/shift-codes",
      "destination": "/configuration/shifts-jobs-and-absences",
      "permanent": true
    },
    {
      "source": "/reference/subscription",
      "destination": "/reference/billing",
      "permanent": true
    },
    {
      "source": "/reference/api-overview",
      "destination": "/reference/integrations-and-exports",
      "permanent": true
    },
    {
      "source": "/reference/calendar-export",
      "destination": "/reference/integrations-and-exports",
      "permanent": true
    }
  ]
}
